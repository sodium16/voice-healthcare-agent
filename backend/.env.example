# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                         VAIDYA BACKEND CONFIGURATION                          ║
# ║                 Copy to .env and fill in your actual values                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────────────────────
# 📌 SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

# Application environment (development | staging | production)
NODE_ENV=development

# Server port
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────────
# 🗄️ QDRANT VECTOR DATABASE (Memory & Context Storage)
# ─────────────────────────────────────────────────────────────────────────────────

# Qdrant URL (local or cloud)
# Local Docker: http://localhost:6333
# Cloud: https://your-cluster.qdrant.io
QDRANT_URL=http://localhost:6333

# Qdrant API key (optional for local, required for cloud)
QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# 🎙️ VAPI VOICE API (Speech-to-Text & Text-to-Speech)
# ─────────────────────────────────────────────────────────────────────────────────

# Vapi API Key
# Get from: https://dashboard.vapi.ai → Settings → API Keys
# Required for voice features
VAPI_API_KEY=

# Vapi Phone Number ID (for inbound calls, optional)
VAPI_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────────────────────────────────────────
# 🤖 LLM/AI SERVICES (For Response Generation)
# Note: At least ONE of these should be configured
# ─────────────────────────────────────────────────────────────────────────────────

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Model: gpt-4 or gpt-3.5-turbo
OPENAI_API_KEY=

# Anthropic Claude API Key
# Get from: https://console.anthropic.com
# Model: claude-3-sonnet or claude-3-opus
CLAUDE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# 🌐 FRONTEND CONFIGURATION (CORS)
# ─────────────────────────────────────────────────────────────────────────────────

# Frontend URL (used for CORS headers)
# Local: http://localhost:5000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────────────────────────
# 📊 LOGGING & DEBUGGING
# ─────────────────────────────────────────────────────────────────────────────────

# Log level (debug | info | warn | error)
# Debug: Very verbose, shows all API calls
# Info: Standard logging
# Warn: Only warnings and errors
# Error: Only errors
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────────
# 💾 DATABASE (Optional - for future use)
# ─────────────────────────────────────────────────────────────────────────────────

# PostgreSQL or MongoDB connection string (future)
DB_URL=

# ─────────────────────────────────────────────────────────────────────────────────
# 🔒 SECURITY (Optional - for future use)
# ─────────────────────────────────────────────────────────────────────────────────

# JWT Secret for authentication (future)
JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────────
# ═════════════════════════════════════════════════════════════════════════════════
# 📋 SETUP INSTRUCTIONS
# ═════════════════════════════════════════════════════════════════════════════════

# 1️⃣  INITIAL SETUP
# ─────────────────────────────────────────────────────────────────────────────────
# 
#   cp .env.example .env
#   
#   Then fill in the values below based on your setup
#

# 2️⃣  START QDRANT (Local Development)
# ─────────────────────────────────────────────────────────────────────────────────
#
#   Docker (Recommended):
#   └─ docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
#
#   Or use cloud:
#   └─ Change QDRANT_URL to: https://your-cluster.qdrant.io
#   └─ Add your API key to QDRANT_API_KEY
#

# 3️⃣  GET VAPI API KEY
# ─────────────────────────────────────────────────────────────────────────────────
#
#   Step 1: Sign up at https://dashboard.vapi.ai
#   Step 2: Go to Settings → API Keys
#   Step 3: Create new API key
#   Step 4: Copy and paste into VAPI_API_KEY
#
#   Voice features REQUIRE this key
#

# 4️⃣  GET OPENAI API KEY (Recommended)
# ─────────────────────────────────────────────────────────────────────────────────
#
#   Step 1: Go to https://platform.openai.com/api-keys
#   Step 2: Sign up or login
#   Step 3: Create new API key
#   Step 4: Copy and paste into OPENAI_API_KEY
#
#   Alternative: Use CLAUDE_API_KEY instead
#

# 5️⃣  START BACKEND
# ─────────────────────────────────────────────────────────────────────────────────
#
#   cd backend
#   npm install
#   npm run dev
#
#   Expected output:
#   ✅ Qdrant initialized
#   ✅ Server running on port 3000
#   Ready to accept requests
#

# 6️⃣  TEST BACKEND
# ─────────────────────────────────────────────────────────────────────────────────
#
#   Health check:
#   $ curl http://localhost:3000/health
#
#   System status:
#   $ curl http://localhost:3000/health/full
#
#   Ask endpoint:
#   $ curl -X POST http://localhost:3000/ask \
#     -H "Content-Type: application/json" \
#     -d '{
#       "user_id": "user_001",
#       "query": "I have a fever",
#       "location": "Bangalore"
#     }'
#

# ═════════════════════════════════════════════════════════════════════════════════
# 🔗 USEFUL LINKS
# ═════════════════════════════════════════════════════════════════════════════════
#
# Qdrant Dashboard:        http://localhost:6334 (if running locally)
# Qdrant Cloud:            https://cloud.qdrant.io
# Vapi Dashboard:          https://dashboard.vapi.ai
# OpenAI Dashboard:        https://platform.openai.com
# Anthropic Console:       https://console.anthropic.com
#
# ═════════════════════════════════════════════════════════════════════════════════
# ⚠️  IMPORTANT NOTES
# ═════════════════════════════════════════════════════════════════════════════════
#
# • NEVER commit .env to version control (already in .gitignore)
# • NEVER share your API keys with anyone
# • In production, use strong, unique keys
# • Rotate keys regularly
# • Use environment-specific .env files for prod/staging
#
# ═════════════════════════════════════════════════════════════════════════════════
